# Frontend Environment Variables (Vite)
# NOTE: All Vite environment variables accessible in the browser must start with VITE_

# Backend API base URL
# Leave empty ("") when using Netlify proxy (/api/* -> Render backend) or local Vite dev proxy.
# If connecting directly without a proxy, provide the full URL (e.g., https://ecdat-backend.onrender.com).
VITE_API_URL=

# Application Title
VITE_APP_TITLE=ECDAT | Cryptographic Discovery & Analysis
