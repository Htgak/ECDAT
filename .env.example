# Local development defaults. Copy to .env only if it does not already exist.
ENVIRONMENT=development
LOG_LEVEL=INFO
ECDAT_DEBUG=false

# Administrator credentials. Set AUTH_PASSWORD directly here to a unique 15-128 character password.
# This account can create normal users from the Users screen.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Optional legacy normal-user imports (JSON or username:password pairs).
# Prefer creating normal users in the admin UI. Leave empty otherwise.
AUTH_USERS=

# Set true only when the browser connects over HTTPS.
SESSION_COOKIE_SECURE=false
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Compose publishes these ports on 127.0.0.1 only.
BACKEND_PORT=8000
FRONTEND_ALT_PORT=3000

