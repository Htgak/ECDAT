# ECDAT Backend — Environment Variables
# Copy this file to .env and customize as needed.

# ------------------------------------------------------------------ #
# Application                                                          #
# ------------------------------------------------------------------ #
ENVIRONMENT=development
ECDAT_DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------ #
# Workspace Security & Access (Optional)                              #
# ------------------------------------------------------------------ #
# Leave empty for open access. When set, users must supply this token,
# or click 'Continue as Guest' for an isolated ephemeral session.
WORKSPACE_ACCESS_TOKEN=
SESSION_COOKIE_SECURE=false

# ------------------------------------------------------------------ #
# Evidence Store (Filesystem storage for uploads and reports)         #
# ------------------------------------------------------------------ #
EVIDENCE_STORE_PATH=./evidence_store

# ------------------------------------------------------------------ #
# CORS & Hosts                                                         #
# ------------------------------------------------------------------ #
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:3000"]
# ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
